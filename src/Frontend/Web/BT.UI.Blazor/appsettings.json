{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "BackendApi": {
    "BaseUrl": "https://localhost:7129/",
    "Version": "1",
    "TransientRetryCount": 2,
    "TransientRetryDelayMilliseconds": 250,
    "Endpoints": {
      "Iam": {
        "Auth": {
          "Login": "api/v{version}/iam/auth/login",
          "RefreshToken": "api/v{version}/iam/auth/refresh-token",
          "CurrentUser": "api/v{version}/iam/auth/me",
          "UpdateProfilePicture": "api/v{version}/iam/users/me/profile-picture",
          "Logout": "api/v{version}/iam/auth/logout"
        },
        "Users": {
          "InitiateTotpSetup": "api/v{version}/iam/users/totp/setup",
          "VerifyTotp": "api/v{version}/iam/users/totp/verify",
          "DisableTotp": "api/v{version}/iam/users/totp/disable",
          "TotpStatus": "api/v{version}/iam/users/totp/{userId}/status"
        },
        "Admin": {
          "Users": "api/v{version}/iam/admin/users",
          "UserUpdate": "api/v{version}/iam/admin/users/{userId}",
          "UserDeactivate": "api/v{version}/iam/admin/users/{userId}/deactivate",
          "UserRoles": "api/v{version}/iam/admin/users/{userId}/roles",
          "UserRolesUpdate": "api/v{version}/iam/admin/users/{userId}/roles",
          "UserPermissions": "api/v{version}/iam/admin/users/{userId}/permissions",
          "UserPermissionsUpdate": "api/v{version}/iam/admin/users/{userId}/permissions",
          "EmployeeGrantAccess": "api/v{version}/iam/admin/employees/{employeeId}/grant-access",
          "EmployeeRevokeAccess": "api/v{version}/iam/admin/employees/{employeeId}/revoke-access",
          "Roles": "api/v{version}/iam/admin/roles",
          "RoleUpdate": "api/v{version}/iam/admin/roles/{roleId}",
          "RoleDelete": "api/v{version}/iam/admin/roles/{roleId}",
          "RolePermissions": "api/v{version}/iam/admin/roles/{roleId}/permissions",
          "RolePermissionsUpdate": "api/v{version}/iam/admin/roles/{roleId}/permissions",
          "Permissions": "api/v{version}/iam/admin/permissions",
          "ReferenceData": "api/v{version}/iam/admin/reference-data",
          "ReferenceCatalog": "api/v{version}/iam/admin/reference-catalogs/{catalogType}",
          "ReferenceCatalogItem": "api/v{version}/iam/admin/reference-catalogs/{catalogType}/{id}",
          "PermissionDetail": "api/v{version}/iam/admin/permissions/{permissionId}",
          "PermissionCreate": "api/v{version}/iam/admin/permissions",
          "PermissionUpdate": "api/v{version}/iam/admin/permissions/{permissionId}",
          "PermissionDelete": "api/v{version}/iam/admin/permissions/{permissionId}",
          "Menus": "api/v{version}/iam/admin/menus",
          "MenuNavigation": "api/v{version}/iam/admin/menus/navigation/{placement}",
          "MenuDetail": "api/v{version}/iam/admin/menus/{menuId}",
          "MenuCreate": "api/v{version}/iam/admin/menus",
          "MenuUpdate": "api/v{version}/iam/admin/menus/{menuId}",
          "MenuDelete": "api/v{version}/iam/admin/menus/{menuId}",
          "UserDevices": "api/v{version}/iam/admin/user-devices",
          "UserDeviceRevoke": "api/v{version}/iam/admin/user-devices/{deviceId}/revoke"
        }
      },
      "Banking": {
        "Customers": {
          "Search": "api/v{version}/banking/customers",
          "Detail": "api/v{version}/banking/customers/{id}",
          "Create": "api/v{version}/banking/customers",
          "Update": "api/v{version}/banking/customers/{id}",
          "Delete": "api/v{version}/banking/customers/{id}"
        }
      },
      "Hr": {
        "Departments": "api/v{version}/hr/departments",
        "DepartmentsActive": "api/v{version}/hr/departments/active",
        "DepartmentDetail": "api/v{version}/hr/departments/{id}",
        "DepartmentCreate": "api/v{version}/hr/departments",
        "DepartmentUpdate": "api/v{version}/hr/departments/{id}",
        "DepartmentDelete": "api/v{version}/hr/departments/{id}",
        "EmployeeSearch": "api/v{version}/hr/employees",
        "EmployeeDetail": "api/v{version}/hr/employees/{id}",
        "EmployeeCreate": "api/v{version}/hr/employees",
        "EmployeeUpdate": "api/v{version}/hr/employees/{id}",
        "EmployeeDelete": "api/v{version}/hr/employees/{id}"
      },
      "Shared": {
        "Payments": {
          "Checkout": "api/v{version}/shared/payments/checkout",
          "Status": "api/v{version}/shared/payments/{provider}/{paymentReference}"
        },
        "LookupCatalogTypes": "api/v{version}/shared/lookups/catalog-types",
        "LookupByType": "api/v{version}/shared/lookups/{lookupType}",
        "LookupCreate": "api/v{version}/shared/lookups/{lookupType}",
        "LookupUpdate": "api/v{version}/shared/lookups/{lookupType}/{id}",
        "LookupDelete": "api/v{version}/shared/lookups/{lookupType}/{id}"
      }
    }
  },
  "SessionLifecycle": {
    "Enabled": true,
    "IdleTimeoutMinutes": 10,
    "WarningBeforeTimeoutMinutes": 2,
    "PollIntervalSeconds": 15,
    "KeepAliveIntervalMinutes": 5,
    "SignInPath": "/iam/sign-in"
  },
  "AllowedHosts": "*"
}
