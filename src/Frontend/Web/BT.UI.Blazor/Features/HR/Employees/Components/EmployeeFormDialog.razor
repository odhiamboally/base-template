@using BT.SharedKernel.Features.HR.Employees.Dtos
@using BT.SharedKernel.Features.HR.Departments.Dtos
@using BT.SharedKernel.Features.Shared.Phone
@using BT.UI.Blazor.Features.HR.Employees.Models
@using BT.UI.Rcl.Features.HR.Departments.Contracts.Interfaces
@inject IDepartmentService DepartmentService
@inject IEmployeeService EmployeeService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudTextField Value="@EmployeeNumberDisplay" Label="Employee No." Margin="Margin.Dense" Variant="Variant.Outlined" ReadOnly="true" HelperText="@EmployeeNumberHelpText" />
                </MudItem>
                <MudItem xs="12" sm="4"><MudTextField @bind-Value="_model.FirstName" Label="First Name" Margin="Margin.Dense" Variant="Variant.Outlined" Required /></MudItem>
                <MudItem xs="12" sm="4"><MudTextField @bind-Value="_model.LastName" Label="Last Name" Margin="Margin.Dense" Variant="Variant.Outlined" Required /></MudItem>
                <MudItem xs="12" sm="4"><MudTextField @bind-Value="_model.Email" Label="Email" Margin="Margin.Dense" Variant="Variant.Outlined" Required /></MudItem>
                <MudItem xs="12" sm="8">
                    <PhoneNumberInput @bind-CountryCode="_model.CountryCode"
                                      @bind-NationalNumber="_model.PhoneNationalNumber"
                                      @bind-E164="_model.PhoneNumber"
                                      CountryColumns="6"
                                      PhoneColumns="6" />
                </MudItem>
                <MudItem xs="12" sm="4"><MudTextField @bind-Value="_model.IdNumber" Label="ID Number" Margin="Margin.Dense" Variant="Variant.Outlined" Required /></MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="Guid" Value="_model.DepartmentId" ValueChanged="OnDepartmentChangedAsync" Label="Department" Margin="Margin.Dense" Variant="Variant.Outlined" Required Disabled="@(!_departments.Any())" ToStringFunc="DepartmentLabel">
                        @foreach (var department in _departments)
                        {
                            <MudSelectItem T="Guid" Value="@department.Id">@department.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="Guid?" @bind-Value="_model.ManagerId" Label="Manager" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" Disabled="_isLoadingManagers" ToStringFunc="ManagerLabel">
                        @foreach (var manager in _managers)
                        {
                            <MudSelectItem T="Guid?" Value="@((Guid?)manager.Id)">@manager.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                @if (ExistingEmployee is null)
                {
                    <MudItem xs="12" sm="6"><MudDatePicker @bind-Date="_model.HireDate" Label="Hire Date" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                }
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Size="Size.Small" Class="bt-mud-primary" Disabled="_isSaving" OnClick="SaveAsync">@(_isSaving ? "Saving..." : "Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private EmployeeFormModel _model = new();
    private readonly List<DepartmentResponse> _departments = [];
    private readonly List<EmployeeResponse> _managers = [];
    private bool _isLoadingManagers;
    private bool _isSaving;

    private string EmployeeNumberDisplay => ExistingEmployee is null ? "Generated on save" : _model.Number;

    private string EmployeeNumberHelpText => ExistingEmployee is null
        ? "Generated from department and year, for example HR-2026-0001."
        : "Employee number is system-generated and cannot be edited.";

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public EmployeeResponse? ExistingEmployee { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _model = ExistingEmployee is null ? new EmployeeFormModel() : EmployeeFormModel.From(ExistingEmployee);
        await LoadDepartmentsAsync();
        await LoadManagersAsync();
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.Number)
            && ExistingEmployee is not null
            || string.IsNullOrWhiteSpace(_model.FirstName)
            || string.IsNullOrWhiteSpace(_model.LastName)
            || string.IsNullOrWhiteSpace(_model.Email)
            || string.IsNullOrWhiteSpace(_model.CountryCode)
            || string.IsNullOrWhiteSpace(_model.PhoneNationalNumber)
            || string.IsNullOrWhiteSpace(_model.IdNumber))
        {
            Snackbar.Add("Employee name, email, phone, and ID number are required.", Severity.Warning);
            return;
        }

        try
        {
            var phone = PhoneNumberFormatter.Normalize(_model.CountryCode, _model.PhoneNationalNumber, _model.PhoneNumber);
            _model.CountryCode = phone.CountryCode;
            _model.PhoneNationalNumber = phone.NationalNumber;
            _model.PhoneNumber = phone.E164;
        }
        catch (ArgumentException)
        {
            Snackbar.Add("Enter a valid phone number for the selected country.", Severity.Warning);
            return;
        }

        if (_model.DepartmentId == Guid.Empty)
        {
            Snackbar.Add("Department is required.", Severity.Warning);
            return;
        }

        _isSaving = true;
        var response = ExistingEmployee is null
            ? await EmployeeService.CreateAsync(_model.ToCreateRequest())
            : await EmployeeService.UpdateAsync(_model.Id, _model.ToUpdateRequest());

        _isSaving = false;
        if (!response.Successful)
        {
            Snackbar.Add(response.Message ?? "Employee save failed.", Severity.Error);
            return;
        }

        Snackbar.Add(ExistingEmployee is null ? "Employee created." : "Employee updated.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(response.Data));
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task LoadDepartmentsAsync()
    {
        var response = await DepartmentService.GetAsync();
        if (!response.Successful || response.Data is null)
        {
            Snackbar.Add(response.Message ?? "We could not load departments.", Severity.Error);
            return;
        }

        _departments.Clear();
        _departments.AddRange(response.Data.OrderBy(static department => department.Name));

        if (_model.DepartmentId == Guid.Empty && _departments.Count > 0)
        {
            _model.DepartmentId = _departments[0].Id;
        }

        if (_departments.Count == 0)
        {
            Snackbar.Add("No active departments were loaded. Please confirm HR seed data and tenant scope.", Severity.Warning);
        }
    }

    private async Task OnDepartmentChangedAsync(Guid departmentId)
    {
        _model.DepartmentId = departmentId;
        _model.ManagerId = null;
        await LoadManagersAsync();
    }

    private async Task LoadManagersAsync()
    {
        if (_model.DepartmentId == Guid.Empty)
        {
            _managers.Clear();
            return;
        }

        _isLoadingManagers = true;
        var response = await EmployeeService.SearchAsync(new EmployeeSearchRequest(DepartmentId: _model.DepartmentId, PageSize: 50));
        _isLoadingManagers = false;

        if (!response.Successful || response.Data is null)
        {
            Snackbar.Add(response.Message ?? "We could not load managers.", Severity.Error);
            return;
        }

        _managers.Clear();
        _managers.AddRange(response.Data.Items
            .Where(employee => employee.Id != _model.Id)
            .OrderBy(static employee => employee.FullName));

        if (ExistingEmployee?.ManagerId is { } managerId
            && managerId != Guid.Empty
            && _model.ManagerId == managerId
            && !_managers.Any(employee => employee.Id == managerId))
        {
            _managers.Add(new EmployeeResponse(
                managerId,
                string.IsNullOrWhiteSpace(ExistingEmployee.ManagerName) ? "Current manager" : ExistingEmployee.ManagerName,
                string.Empty,
                string.Empty,
                string.Empty,
                string.Empty,
                _model.DepartmentId,
                null,
                DepartmentName: string.Empty,
                ManagerName: string.Empty,
                CountryCode: PhoneNumberFormatter.DefaultCountryCode,
                PhoneNationalNumber: string.Empty));
        }
    }

    private string ManagerLabel(Guid? managerId)
    {
        if (!managerId.HasValue || managerId.Value == Guid.Empty)
        {
            return string.Empty;
        }

        return _managers.FirstOrDefault(employee => employee.Id == managerId.Value)?.FullName
            ?? ExistingEmployee?.ManagerName
            ?? "Current manager";
    }

    private string DepartmentLabel(Guid departmentId)
    {
        if (departmentId == Guid.Empty)
        {
            return _departments.Count == 0 ? "No departments loaded" : string.Empty;
        }

        return _departments.FirstOrDefault(department => department.Id == departmentId)?.Name
            ?? "Unknown department";
    }
}
