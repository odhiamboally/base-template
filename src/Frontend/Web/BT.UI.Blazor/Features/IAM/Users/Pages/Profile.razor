@page "/profile"
@rendermode InteractiveServer
@inject IAuthSession AuthSession
@inject NavigationManager Navigation

<PageTitle>Profile | Base Template</PageTitle>

<section class="dashboard-page">
    @if (!_isReady)
    {
        <MudPaper Class="status-card" Elevation="0">Loading profile...</MudPaper>
    }
    else
    {
        <div class="dashboard-hero compact-hero">
            <div>
                <span class="eyebrow">Profile</span>
                <h1>@DisplayName</h1>
                <p>@AuthSession.CurrentUser?.Email</p>
            </div>
            <MudButton Href="/iam/security" Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Filled.Security" Class="bt-mud-primary bt-small-button">
                Security settings
            </MudButton>
        </div>

        <MudPaper Class="poc-panel profile-detail-card" Elevation="0">
            <MudGrid Spacing="3" Class="profile-detail-grid">
                <MudItem xs="12" md="3">
                    <div class="profile-summary-card embedded">
                        <MudAvatar Size="Size.Large" Class="profile-avatar-large">@Initials</MudAvatar>
                        <h2>@DisplayName</h2>
                        <span>@(AuthSession.CurrentUser?.Roles.FirstOrDefault() ?? "Signed in")</span>
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">Active</MudChip>
                    </div>
                </MudItem>

                <MudItem xs="12" md="9">
                    <div class="panel-heading">
                        <div>
                            <span class="eyebrow">Account details</span>
                            <h2>Signed-in user</h2>
                        </div>
                    </div>

                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <strong>Username</strong>
                            <p>@AuthSession.CurrentUser?.UserName</p>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <strong>Email</strong>
                            <p>@AuthSession.CurrentUser?.Email</p>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <strong>Role</strong>
                            <p>@(AuthSession.CurrentUser?.Roles.FirstOrDefault() ?? "Signed in")</p>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <strong>Two-factor</strong>
                            <p>@(AuthSession.CurrentUser?.TwoFactorEnabled == true ? "Enabled" : "Recommended")</p>
                        </MudItem>
                    </MudGrid>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
</section>

@code {
    private bool _isReady = true;

    private string DisplayName
    {
        get
        {
            var fullName = $"{AuthSession.CurrentUser?.FirstName} {AuthSession.CurrentUser?.LastName}".Trim();
            return string.IsNullOrWhiteSpace(fullName) ? AuthSession.CurrentUser?.Email ?? "Signed-in user" : fullName;
        }
    }

    private string Initials
    {
        get
        {
            var first = AuthSession.CurrentUser?.FirstName;
            var last = AuthSession.CurrentUser?.LastName;
            if (!string.IsNullOrWhiteSpace(first) && !string.IsNullOrWhiteSpace(last))
            {
                return $"{first[0]}{last[0]}".ToUpperInvariant();
            }

            var email = AuthSession.CurrentUser?.Email;
            return string.IsNullOrWhiteSpace(email) ? "BT" : email[..1].ToUpperInvariant();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AuthSession.InitializeAsync();
        if (!AuthSession.IsAuthenticated)
        {
            Navigation.NavigateTo("/iam/sign-in");
            return;
        }

        _isReady = true;
        StateHasChanged();
    }
}
