@page "/iam/security"
@rendermode InteractiveServer
@using BT.UI.Blazor.Features.Shared.Messaging
@inject IAuthSession AuthSession
@inject IAuthService AuthService
@inject IAuthenticatorQrCodeService QrCodeService
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>Security | Base Template</PageTitle>

<RequireAuthenticated>
    <section class="security-page">
        <div class="security-hero">
            <div>
                <span class="eyebrow">Account security</span>
                <h1>@DisplayName</h1>
                <p>@AuthSession.CurrentUser?.Email</p>
            </div>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Logout" OnClick="SignOutAsync">Sign out</MudButton>
        </div>

        <div class="security-grid">
            <article class="security-card">
                <div class="card-heading">
                    <span>Two-factor authentication</span>
                    <strong class="@(_otpStatus?.IsEnabled == true ? "status-good" : "status-warn")">
                        @(_otpStatus?.IsEnabled == true ? "Enabled" : "Action needed")
                    </strong>
                </div>
                <p>
                    Authenticator-app TOTP is the preferred base-template flow because it works with Microsoft Authenticator,
                    Google Authenticator, 1Password, and similar enterprise password managers.
                </p>

                @if (!_hasLoadedOtpStatus)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                        Loading two-factor status...
                    </MudAlert>
                }
                else if (_otpStatus is null)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                        We could not load your two-factor status. Please refresh the page or sign in again.
                    </MudAlert>
                }
                else
                {
                    <dl class="status-list">
                        <div>
                            <dt>Provider</dt>
                            <dd>@_otpStatus.DisplayName</dd>
                        </div>
                        <div>
                            <dt>Configured</dt>
                            <dd>@(_otpStatus.IsConfigured ? "Yes" : "No")</dd>
                        </div>
                    </dl>
                }

                <MudStack Row="true" Spacing="2" Class="security-actions">
                    <MudButton Variant="Variant.Filled" Class="bt-mud-primary" OnClick="StartTotpSetupAsync" Disabled="@(_isBusy || IsTotpEnabled)">
                        @SetupButtonText
                    </MudButton>

                    @if (IsTotpEnabled)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DisableTotpAsync" Disabled="@_isBusy">
                            Disable authenticator app
                        </MudButton>
                    }
                </MudStack>
            </article>

            <article class="security-card setup-card">
                <div class="card-heading">
                    <span>Authenticator setup</span>
                    <strong>30-minute setup window</strong>
                </div>

                @if (_setupInfo is null)
                {
                    <p>@(IsTotpEnabled
                            ? "Authenticator-app 2FA is enabled. Use the audited disable action if this device is lost, replaced, or no longer trusted."
                            : "Start setup to generate a temporary TOTP secret. The secret is only committed after a valid code is verified.")</p>
                }
                else
                {
                    <p>Add this account to your authenticator app, then verify the first generated code below.</p>

                    <div class="qr-panel">
                        <img src="@_qrCodeDataUri" alt="Authenticator app QR code" />
                        <span>Scan with Microsoft Authenticator, Google Authenticator, 1Password, or another TOTP app.</span>
                    </div>

                    <label>Manual entry key</label>
                    <div class="copy-box">@_setupInfo.ManualEntryKey</div>

                <EditForm FormName="iam-security-verify-setup" Model="_verification" OnValidSubmit="VerifySetupAsync">
                    <DataAnnotationsValidator />
                        <div class="form-stack mt-3">
                            <div>
                                <label for="setup-code">6-digit code</label>
                                <InputText id="setup-code" class="form-control form-control-lg otp-input" @bind-Value="_verification.Code" inputmode="numeric" autocomplete="one-time-code" />
                                <ValidationMessage For="@(() => _verification.Code)" />
                            </div>

                            <MudButton Variant="Variant.Filled" Class="bt-mud-primary" ButtonType="ButtonType.Submit" Disabled="@_isBusy">
                                @(_isBusy ? "Verifying..." : "Verify and enable 2FA")
                            </MudButton>
                        </div>
                    </EditForm>
                }

                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <MudAlert Severity="@(_isError ? Severity.Error : Severity.Success)" Variant="Variant.Outlined" Class="mt-3">@_message</MudAlert>
                }
            </article>
        </div>
    </section>
</RequireAuthenticated>

@code {
    private bool _isBusy;
    private bool _isError;
    private bool _hasLoadedOtpStatus;
    private string? _message;
    private string? _qrCodeDataUri;
    private BT.SharedKernel.Features.IAM.Users.Dtos.OtpStatusResponse? _otpStatus;
    private BT.SharedKernel.Features.IAM.Users.Dtos.TwoFactorSetupInfo? _setupInfo;
    private readonly TotpVerificationModel _verification = new();

    private bool IsTotpEnabled => _otpStatus?.IsEnabled == true;

    private string SetupButtonText => IsTotpEnabled
        ? "Authenticator app enabled"
        : _setupInfo is null ? "Set up authenticator app" : "Regenerate setup code";

    private string DisplayName
    {
        get
        {
            var fullName = $"{AuthSession.CurrentUser?.FirstName} {AuthSession.CurrentUser?.LastName}".Trim();
            return string.IsNullOrWhiteSpace(fullName) ? AuthSession.CurrentUser?.Email ?? "Signed-in user" : fullName;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !AuthSession.IsAuthenticated || AuthSession.CurrentUser is null || _hasLoadedOtpStatus)
        {
            return;
        }

        _verification.UserId = AuthSession.CurrentUser.AppUserId;
        await LoadOtpStatusAsync();
        StateHasChanged();
    }

    private async Task LoadOtpStatusAsync()
    {
        if (AuthSession.CurrentUser is null)
        {
            _hasLoadedOtpStatus = true;
            return;
        }

        _hasLoadedOtpStatus = false;
        var status = await AuthService.GetTotpStatusAsync(AuthSession.CurrentUser.AppUserId);
        if (status.IsSuccess)
        {
            _otpStatus = status.Data;
        }
        else
        {
            _otpStatus = null;
        }

        _hasLoadedOtpStatus = true;
    }

    private async Task StartTotpSetupAsync()
    {
        if (IsTotpEnabled)
        {
            return;
        }

        _isBusy = true;
        _isError = false;
        _message = null;

        var response = await AuthService.InitiateTotpSetupAsync();
        _isBusy = false;

        if (!response.IsSuccess || response.Data is null)
        {
            _isError = true;
            _message = UserMessageSanitizer.Normalize(response.Message, "Could not start two-factor setup.");
            return;
        }

        _setupInfo = response.Data;
        _qrCodeDataUri = QrCodeService.GenerateDataUri(response.Data.QrCodeUri);
        _message = "Temporary authenticator secret generated. Verify a code to enable 2FA.";
    }

    private async Task VerifySetupAsync()
    {
        if (AuthSession.CurrentUser is null)
        {
            Navigation.NavigateTo("/iam/sign-in");
            return;
        }

        _isBusy = true;
        _isError = false;
        _message = null;

        var response = await AuthSession.CompleteTwoFactorAsync(new BT.SharedKernel.Features.IAM.Users.Dtos.VerifyOtpRequest
        {
            UserId = AuthSession.CurrentUser.AppUserId,
            Code = _verification.Code,
            RememberMe = false,
            RememberDevice = true,
            DeviceFingerprint = _verification.DeviceFingerprint
        });

        _isBusy = false;

        if (!response.IsSuccess)
        {
            _isError = true;
            _message = UserMessageSanitizer.Normalize(response.Message, "Could not enable two-factor authentication.");
            return;
        }

        _message = "Two-factor authentication is now enabled for this account.";
        _setupInfo = null;
        _qrCodeDataUri = null;
        _verification.Code = string.Empty;
        await AuthSession.RefreshAsync();
        await LoadOtpStatusAsync();
        Navigation.NavigateTo("/dashboard", replace: true);
    }

    private async Task DisableTotpAsync()
    {
        if (!IsTotpEnabled)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            { nameof(ConfirmDialog.Message), "Disable authenticator-app 2FA for this account? You will be able to set it up again, and this action will be logged for audit." },
            { nameof(ConfirmDialog.ConfirmText), "Disable" }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            "Disable Authenticator App",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result is not { Canceled: false })
        {
            return;
        }

        _isBusy = true;
        _isError = false;
        _message = null;

        var response = await AuthService.DisableTotpAsync();
        _isBusy = false;

        if (!response.IsSuccess)
        {
            _isError = true;
            _message = UserMessageSanitizer.Normalize(response.Message, "Could not disable authenticator-app 2FA.");
            return;
        }

        _setupInfo = null;
        _qrCodeDataUri = null;
        _otpStatus = new BT.SharedKernel.Features.IAM.Users.Dtos.OtpStatusResponse(
            IsConfigured: false,
            IsEnabled: false,
            ProviderName: "Authenticator",
            DisplayName: "Authenticator App");
        _hasLoadedOtpStatus = true;
        await AuthSession.RefreshAsync();
        if (!AuthSession.IsAuthenticated || AuthSession.MfaEnrollmentRequired)
        {
            await AuthSession.SignOutAsync();
            Navigation.NavigateTo("/iam/sign-in", replace: true);
            return;
        }

        await LoadOtpStatusAsync();
        _message = response.Message ?? "Authenticator-app 2FA has been disabled.";
    }

    private async Task SignOutAsync()
    {
        await AuthSession.SignOutAsync();
        Navigation.NavigateTo("/iam/sign-in");
    }
}
