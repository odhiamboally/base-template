@page "/iam/forgot-password"
@layout AuthLayout
@rendermode InteractiveServer
@using BT.UI.Blazor.Features.Shared.Messaging
@inject IAuthService AuthService
@inject BT.UI.Blazor.Features.IAM.Users.State.PasswordRecoveryState RecoveryState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Forgot password | Base Template</PageTitle>

<section class="auth-shell">
    <div class="auth-copy">
        <span class="eyebrow">Account recovery</span>
        <h1>Recover access securely.</h1>
        <p>Enter your account email. We will use the recovery method selected by your organization.</p>
    </div>

    <div class="auth-card">
        @if (!_requestSubmitted)
        {
            <EditForm FormName="iam-forgot-password" Model="_emailModel" OnValidSubmit="RequestRecoveryAsync">
                <DataAnnotationsValidator />
                <div class="form-stack">
                    <div>
                        <label for="recovery-email">Email</label>
                        <InputText id="recovery-email" class="form-control form-control-lg" @bind-Value="_emailModel.Email" autocomplete="email" />
                        <ValidationMessage For="@(() => _emailModel.Email)" />
                    </div>

                    <button class="btn btn-bt-primary btn-lg" type="submit" disabled="@_isBusy">
                        @(_isBusy ? "Sending..." : "Continue")
                    </button>
                </div>
            </EditForm>
        }
        else if (_requiresCode)
        {
            <EditForm FormName="iam-password-reset-otp" Model="_otpModel" OnValidSubmit="VerifyCodeAsync">
                <DataAnnotationsValidator />
                <div class="form-stack">
                    <div class="alert alert-success" role="status">
                        If an active account matches that email, a 6-digit recovery code has been sent.
                    </div>
                    <div>
                        <label for="recovery-code">6-digit code</label>
                        <InputText id="recovery-code" class="form-control form-control-lg" @bind-Value="_otpModel.Code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" />
                        <ValidationMessage For="@(() => _otpModel.Code)" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_message))
                    {
                        <div class="alert alert-danger" role="alert">@_message</div>
                    }

                    <button class="btn btn-bt-primary btn-lg" type="submit" disabled="@_isBusy">
                        @(_isBusy ? "Verifying..." : "Verify code")
                    </button>
                </div>
            </EditForm>
        }
        else
        {
            <div class="form-stack">
                <div class="alert alert-success" role="status">
                    If an active account matches that email, a secure password-reset link has been sent.
                </div>
                <a class="btn btn-bt-primary btn-lg" href="/iam/sign-in">Return to sign in</a>
            </div>
        }

        <div class="dev-hint">
            <a class="auth-recovery-link" href="/iam/sign-in">Back to sign in</a>
        </div>
    </div>
</section>

@code {
    private readonly ForgotPasswordFormModel _emailModel = new();
    private readonly PasswordResetOtpFormModel _otpModel = new();
    private bool _isBusy;
    private bool _requestSubmitted;
    private bool _requiresCode;
    private string? _message;

    private async Task RequestRecoveryAsync()
    {
        _isBusy = true;
        _message = null;

        var response = await AuthService
            .ForgotPasswordAsync(new ForgotPasswordRequest(_emailModel.Email.Trim()))
            .ConfigureAwait(true);

        _isBusy = false;
        if (!response.IsSuccess || response.Data is null)
        {
            _message = UserMessageSanitizer.Normalize(response.Message, "Password recovery is temporarily unavailable. Please try again.");
            Snackbar.Add(_message, Severity.Error);
            return;
        }

        _requiresCode = response.Data.RequiresCode;
        _requestSubmitted = true;
    }

    private async Task VerifyCodeAsync()
    {
        _isBusy = true;
        _message = null;

        var response = await AuthService
            .VerifyPasswordResetOtpAsync(new VerifyPasswordResetOtpRequest(_emailModel.Email.Trim(), _otpModel.Code.Trim()))
            .ConfigureAwait(true);

        _isBusy = false;
        if (!response.IsSuccess || string.IsNullOrWhiteSpace(response.Data?.TransitionToken))
        {
            _message = UserMessageSanitizer.Normalize(response.Message, "The recovery code is invalid or expired.");
            return;
        }

        RecoveryState.Set(_emailModel.Email.Trim(), response.Data.TransitionToken);
        Navigation.NavigateTo("/iam/reset-password");
    }
}
