@using BT.SharedKernel.Features.IAM.Permissions.Dtos
@using BT.SharedKernel.Features.IAM.Users.Dtos
@inject IIamAdminService IamAdminService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (_isLoading)
        {
            <MudProgressLinear Color="Color.Success" Indeterminate="true" />
        }
        else
        {
            <MudStack Spacing="2">
                <MudText Typo="Typo.body2">Direct permissions are exceptions granted to <strong>@DisplayName</strong> outside role membership.</MudText>
                <div class="bt-table-scroll">
                    <MudTable Items="_permissions" Dense="true" Hover="true" Elevation="0" FixedHeader="true" Height="28rem" Style="min-width: 760px;" Breakpoint="Breakpoint.None">
                        <HeaderContent>
                            <MudTh Style="width: 4rem;">Grant</MudTh>
                            <MudTh>Key</MudTh>
                            <MudTh>Context</MudTh>
                            <MudTh>Resource</MudTh>
                            <MudTh>Description</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Grant">
                                <MudCheckBox T="bool" Value="@IsSelected(context.Key)" ValueChanged="@((selected) => TogglePermission(context.Key, selected))" Color="Color.Success" Dense="true" />
                            </MudTd>
                            <MudTd DataLabel="Key">@context.Key</MudTd>
                            <MudTd DataLabel="Context">@context.Context</MudTd>
                            <MudTd DataLabel="Resource">@context.Resource</MudTd>
                            <MudTd DataLabel="Description">@context.Description</MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Size="Size.Small" Class="bt-mud-primary" Disabled="@(_isLoading || _isSaving)" OnClick="SaveAsync">@(_isSaving ? "Saving..." : "Update")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly List<PermissionResponse> _permissions = [];
    private readonly HashSet<string> _selectedKeys = new(StringComparer.OrdinalIgnoreCase);
    private bool _isLoading = true;
    private bool _isSaving;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public AdminUserListResponse User { get; set; } = default!;

    private string DisplayName => string.IsNullOrWhiteSpace(User.FullName) ? User.UserName : User.FullName;

    protected override async Task OnInitializedAsync()
    {
        var permissionsResponse = await IamAdminService.SearchPermissionsAsync(new PermissionSearchRequest(IsActive: true, PageSize: 50));
        var userPermissionsResponse = await IamAdminService.GetUserPermissionsAsync(User.Id);

        if (!permissionsResponse.Successful || permissionsResponse.Data is null)
        {
            Snackbar.Add(permissionsResponse.Message ?? "We could not load permissions.", Severity.Error);
            _isLoading = false;
            return;
        }

        if (!userPermissionsResponse.Successful || userPermissionsResponse.Data is null)
        {
            Snackbar.Add(userPermissionsResponse.Message ?? "We could not load user permissions.", Severity.Error);
            _isLoading = false;
            return;
        }

        _permissions.AddRange(permissionsResponse.Data.Items);
        foreach (var key in userPermissionsResponse.Data.PermissionKeys)
        {
            _selectedKeys.Add(key);
        }

        _isLoading = false;
    }

    private bool IsSelected(string key) => _selectedKeys.Contains(key);

    private void TogglePermission(string key, bool selected)
    {
        if (selected)
        {
            _selectedKeys.Add(key);
            return;
        }

        _selectedKeys.Remove(key);
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        var response = await IamAdminService.UpdateUserPermissionsAsync(User.Id, new UpdateUserPermissionsRequest([.. _selectedKeys.Order(StringComparer.OrdinalIgnoreCase)]));
        _isSaving = false;

        if (!response.Successful)
        {
            Snackbar.Add(response.Message ?? "User permission update failed.", Severity.Error);
            return;
        }

        Snackbar.Add("Direct user permissions updated.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(response.Data));
    }

    private void Cancel() => MudDialog.Cancel();
}
