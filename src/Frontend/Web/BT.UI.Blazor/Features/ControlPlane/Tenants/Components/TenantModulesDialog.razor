@using MudBlazor
@using BT.SharedKernel.Features.ControlPlane.Tenants.Dtos
@using BT.UI.Blazor.Features.ControlPlane.Tenants.Contracts
@inject ITenantService TenantService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudText Typo="Typo.body2">Manage modules enabled for <strong>@ExistingTenant.DisplayName</strong>.</MudText>
            </MudItem>

            @foreach (var module in _enabledModules)
            {
                <MudItem xs="12" Class="d-flex align-center">
                    <MudText Typo="Typo.body1" Class="flex-grow-1">@module</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => RemoveModuleAsync(module))" title="Remove module" Disabled="_isBusy" />
                </MudItem>
            }

            <MudItem xs="12" Class="mt-4">
                <div class="d-flex gap-2">
                    <MudSelect T="string" @bind-Value="_newModuleKey" Label="Module" Margin="Margin.Dense" Variant="Variant.Outlined" Disabled="_isBusy">
                        <MudSelectItem T="string" Value="@("IAM")">IAM</MudSelectItem>
                        <MudSelectItem T="string" Value="@("HR")">HR</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Banking")">Banking</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Shared")">Shared</MudSelectItem>
                    </MudSelect>
                    <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" Class="mt-1" OnClick="AddModuleAsync" Disabled="@(string.IsNullOrWhiteSpace(_newModuleKey) || _isBusy)">Add</MudButton>
                </div>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="Cancel">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<string> _enabledModules = [];
    private string _newModuleKey = string.Empty;
    private bool _isBusy;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public TenantResponse ExistingTenant { get; set; } = default!;

    protected override void OnInitialized()
    {
        _enabledModules = [.. ExistingTenant.EnabledModules];
    }

    private async Task AddModuleAsync()
    {
        if (string.IsNullOrWhiteSpace(_newModuleKey)) return;

        var key = _newModuleKey.Trim();
        if (_enabledModules.Contains(key, StringComparer.OrdinalIgnoreCase))
        {
            Snackbar.Add("Module is already enabled for this tenant.", Severity.Warning);
            return;
        }

        _isBusy = true;
        var response = await TenantService.AddModuleAsync(ExistingTenant.Id, new AddTenantModuleRequest { ModuleKey = key });
        _isBusy = false;

        if (!response.IsSuccess)
        {
            Snackbar.Add(response.Message ?? "Failed to add module.", Severity.Error);
            return;
        }

        Snackbar.Add($"Module '{key}' added.", Severity.Success);
        _newModuleKey = string.Empty;
        if (response.Data is not null)
        {
            _enabledModules = [.. response.Data.EnabledModules];
            ExistingTenant = response.Data;
        }
        else
        {
            _enabledModules.Add(key);
        }
    }

    private async Task RemoveModuleAsync(string moduleKey)
    {
        _isBusy = true;
        var response = await TenantService.RemoveModuleAsync(ExistingTenant.Id, moduleKey);
        _isBusy = false;

        if (!response.IsSuccess)
        {
            Snackbar.Add(response.Message ?? "Failed to remove module.", Severity.Error);
            return;
        }

        Snackbar.Add($"Module '{moduleKey}' removed.", Severity.Success);
        if (response.Data is not null)
        {
            _enabledModules = [.. response.Data.EnabledModules];
            ExistingTenant = response.Data;
        }
        else
        {
            _enabledModules.Remove(moduleKey);
        }
    }

    private void Cancel() => MudDialog.Close(DialogResult.Ok(ExistingTenant));
}
