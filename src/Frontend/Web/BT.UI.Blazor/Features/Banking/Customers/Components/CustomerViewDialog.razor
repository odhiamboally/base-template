@using BT.SharedKernel.Features.Banking.Customers.Dtos

<MudDialog>
    <DialogContent>
        <MudTabs Rounded="true" ActivePanelIndex="@InitialTab">
            <MudTabPanel Text="Corporate Details">
                <MudGrid Spacing="2" Class="dialog-detail-grid">
                    <MudItem xs="12" sm="6"><strong>Customer No.</strong><p>@Customer?.Number</p></MudItem>
                    <MudItem xs="12" sm="6"><strong>Company</strong><p>@Customer?.CompanyName</p></MudItem>
                    <MudItem xs="12" sm="6"><strong>Type</strong><p>@Customer?.Type</p></MudItem>
                    <MudItem xs="12" sm="6"><strong>Segment</strong><p>@Customer?.SegmentType</p></MudItem>
                    <MudItem xs="12" sm="6"><strong>Registration No.</strong><p>@Customer?.RegistrationNumber</p></MudItem>
                    <MudItem xs="12" sm="6"><strong>TIN</strong><p>@Customer?.TINNumber</p></MudItem>
                    <MudItem xs="12" sm="6"><strong>Line of business</strong><p>@Customer?.LineOfBusiness</p></MudItem>
                    <MudItem xs="12" sm="6"><strong>Relationship manager</strong><p>@Customer?.RelationshipManagerName</p></MudItem>
                </MudGrid>
            </MudTabPanel>
            <MudTabPanel Text="Address">
                <MudGrid Spacing="2" Class="dialog-detail-grid">
                    <MudItem xs="12" sm="6"><strong>Country</strong><p>@Customer?.Country</p></MudItem>
                    <MudItem xs="12" sm="6"><strong>Region</strong><p>@Customer?.Region</p></MudItem>
                    <MudItem xs="12" sm="6"><strong>Mobile</strong><p>@Customer?.Mobile</p></MudItem>
                    <MudItem xs="12" sm="6"><strong>Email</strong><p>@Customer?.EmailId</p></MudItem>
                    <MudItem xs="12"><strong>Business address</strong><p>@Customer?.BusinessAddress</p></MudItem>
                </MudGrid>
            </MudTabPanel>
            <MudTabPanel Text="Communication">
                <MudGrid Spacing="2" Class="dialog-detail-grid">
                    <MudItem xs="12" sm="6"><strong>Greetings</strong><p>@YesNo(Customer?.CanSendGreetings)</p></MudItem>
                    <MudItem xs="12" sm="6"><strong>Associate offers</strong><p>@YesNo(Customer?.CanSendAssociateSpecialOffer)</p></MudItem>
                    <MudItem xs="12" sm="6"><strong>Special offers</strong><p>@YesNo(Customer?.CanSendOurSpecialOffers)</p></MudItem>
                    <MudItem xs="12" sm="6"><strong>Online statement</strong><p>@YesNo(Customer?.StatementOnline)</p></MudItem>
                    <MudItem xs="12" sm="6"><strong>Mobile alert</strong><p>@YesNo(Customer?.MobileAlert)</p></MudItem>
                </MudGrid>
            </MudTabPanel>
            <MudTabPanel Text="Directors">
                @if (Customer?.Directors.Count > 0)
                {
                    <MudTable Items="Customer.Directors" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh>Relation</MudTh>
                            <MudTh>Identification</MudTh>
                            <MudTh>Email</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.FullName</MudTd>
                            <MudTd>@context.RelationType</MudTd>
                            <MudTd>@context.IdentificationNumber</MudTd>
                            <MudTd>@context.Email</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">No directors recorded.</MudAlert>
                }
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public CustomerResponse? Customer { get; set; }

    [Parameter]
    public int InitialTab { get; set; }

    private static string YesNo(bool? value) => value == true ? "Yes" : "No";

    private void Close() => MudDialog.Close();
}
