@page "/payments/cancel"

<PageTitle>Payment Cancelled | Base Template</PageTitle>

<section class="dashboard-page">
    <MudPaper Class="poc-panel" Elevation="0">
        <span class="eyebrow">Payments</span>
        <h1>Checkout cancelled.</h1>
        <p>No payment was completed. You can return to the card payment screen and try again.</p>
        <MudButton Href="/payments/card" Variant="Variant.Filled" Class="bt-mud-primary bt-small-button">
            Try again
        </MudButton>
    </MudPaper>
</section>
