@page "/payments/success"

<PageTitle>Payment Successful | Base Template</PageTitle>

<section class="dashboard-page">
    <MudPaper Class="poc-panel" Elevation="0">
        <span class="eyebrow">Payments</span>
        <h1>Payment submitted.</h1>
        <p>Stripe has accepted the checkout result. The backend webhook is responsible for final payment confirmation.</p>
        <MudButton Href="/dashboard" Variant="Variant.Filled" Class="bt-mud-primary bt-small-button">
            Back to dashboard
        </MudButton>
    </MudPaper>
</section>
