@page "/dashboard"
@rendermode InteractiveServer
@inject IAuthSession AuthSession
@inject NavigationManager Navigation

<PageTitle>Dashboard | Base Template</PageTitle>

<section class="dashboard-page">
    <div class="dashboard-hero compact-hero">
        <div>
            <span class="eyebrow">Operations dashboard</span>
            <h1>Welcome back, @DisplayName.</h1>
            <p>POC-ready workspace with placeholders for the operational data we will wire as features mature.</p>
        </div>
        <MudButton Href="/iam/security" Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Filled.Security" Class="bt-mud-primary bt-small-button">
            Security setup
        </MudButton>
    </div>

    <MudGrid Spacing="3">
        @foreach (var tile in _summaryTiles)
        {
            <MudItem xs="12" sm="6" lg="3">
                <MudPaper Class="poc-tile" Elevation="0">
                    <MudIcon Icon="@tile.Icon" Class="tile-icon" />
                    <span>@tile.Label</span>
                    <strong>@tile.Value</strong>
                    <small>@tile.Caption</small>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <MudGrid Spacing="3" Class="mt-3">
        <MudItem xs="12" lg="7">
            <MudPaper Class="poc-panel" Elevation="0">
                <div class="panel-heading">
                    <div>
                        <span class="eyebrow">Feature readiness</span>
                        <h2>Implementation map</h2>
                    </div>
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small">POC shell</MudChip>
                </div>

                <MudTable Items="_featureRows" Dense="true" Hover="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Area</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Next move</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Area">@context.Area</MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip T="string" Size="Size.Small" Color="@context.Color" Variant="Variant.Filled">@context.Status</MudChip>
                        </MudTd>
                        <MudTd DataLabel="Next move">@context.NextMove</MudTd>
                        <MudTd DataLabel="Actions">
                            <TableRowActions ExtraActions="@(["Review backlog"])" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="5">
            <MudPaper Class="poc-panel" Elevation="0">
                <div class="panel-heading">
                    <div>
                        <span class="eyebrow">Security posture</span>
                        <h2>Identity health</h2>
                    </div>
                </div>

                <div class="readiness-list">
                    <div>
                        <MudIcon Icon="@Icons.Material.Filled.Login" />
                        <span>API-backed login</span>
                        <strong>Ready</strong>
                    </div>
                    <div>
                        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" />
                        <span>Role-driven admin shell</span>
                        <strong>Draft</strong>
                    </div>
                    <div>
                        <MudIcon Icon="@Icons.Material.Filled.Password" />
                        <span>Authenticator 2FA</span>
                        <strong>@(AuthSession.CurrentUser?.TwoFactorEnabled == true ? "Enabled" : "Recommended")</strong>
                    </div>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
</section>

@code {
    private readonly SummaryTile[] _summaryTiles =
    [
        new("Bounded contexts", "4", "IAM, Banking, HR, Shared", Icons.Material.Filled.AccountTree),
        new("Architecture checks", "44", "Guardrails passing", Icons.Material.Filled.FactCheck),
        new("Admin modules", "5", "Users, roles, permissions...", Icons.Material.Filled.AdminPanelSettings),
        new("Security setup", "2FA", "Recommended for admins", Icons.Material.Filled.Security)
    ];

    private readonly FeatureRow[] _featureRows =
    [
        new("IAM", "Active", "Add user/role management screens", Color.Success),
        new("Administration", "Scaffolded", "Wire Users, Employees, Customers, Roles", Color.Info),
        new("Feature flags", "Planned", "Add generic flag abstraction", Color.Warning),
        new("Observability", "Configured", "Turn on local Seq/OpenTelemetry flow", Color.Primary)
    ];

    private string DisplayName
    {
        get
        {
            var fullName = $"{AuthSession.CurrentUser?.FirstName} {AuthSession.CurrentUser?.LastName}".Trim();
            return string.IsNullOrWhiteSpace(fullName) ? AuthSession.CurrentUser?.Email ?? "there" : fullName;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AuthSession.InitializeAsync();
        if (!AuthSession.IsAuthenticated)
        {
            Navigation.NavigateTo("/iam/sign-in");
            return;
        }

        StateHasChanged();
    }

    private sealed record SummaryTile(string Label, string Value, string Caption, string Icon);

    private sealed record FeatureRow(string Area, string Status, string NextMove, Color Color);
}
