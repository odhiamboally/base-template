@page "/admin/departments"
@rendermode InteractiveServer
@inject IAuthSession AuthSession
@inject IDepartmentService DepartmentService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Departments | Base Template</PageTitle>

<section class="dashboard-page">
    <div class="dashboard-hero compact-hero">
        <div>
            <span class="eyebrow">Administration</span>
            <h1>Departments.</h1>
            <p>Department records are loaded from the HR API and used by employee screens for meaningful staff grouping.</p>
        </div>
        @if (AuthSession.HasPermission("departments.create"))
        {
            <MudButton Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Filled.AccountTree" Class="bt-mud-primary bt-small-button" OnClick="@(() => OpenFormDialogAsync(null))">Create department</MudButton>
        }
    </div>

    <MudPaper Class="poc-panel" Elevation="0">
        <div class="panel-heading">
            <div>
                <span class="eyebrow">Department list</span>
                <h2>Organization units</h2>
            </div>
            <MudChip T="string" Size="Size.Small" Color="Color.Success">@_statusLabel</MudChip>
        </div>

        <div class="list-toolbar">
            <MudTextField @bind-Value="_searchText"
                          Placeholder="Search code, name, description..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Margin="Margin.Dense"
                          Variant="Variant.Outlined"
                          Immediate="false"
                          DebounceInterval="400"
                          OnDebounceIntervalElapsed="ApplyFiltersAsync"
                          OnKeyDown="HandleSearchKeyDown" />
            <MudIconButton Icon="@Icons.Material.Filled.FilterList" Size="Size.Small" Color="@(_showFilters ? Color.Success : Color.Default)" OnClick="ToggleFilters" title="Advanced filters" />
            @if (HasActiveFilters)
            {
                <MudIconButton Icon="@Icons.Material.Filled.FilterAltOff" Size="Size.Small" Color="Color.Error" OnClick="ClearFiltersAsync" title="Clear filters" />
            }
        </div>

        @if (_showFilters)
        {
            <MudDivider Class="my-2" />
            <MudGrid Spacing="2" Class="mb-2">
                <MudItem xs="12" sm="6" lg="3">
                    <MudSelect @bind-Value="_isActiveFilter" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                        <MudSelectItem T="bool?" Value="@((bool?)true)">Active</MudSelectItem>
                        <MudSelectItem T="bool?" Value="@((bool?)false)">Inactive</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>
            <div class="filter-actions">
                <MudButton Variant="Variant.Filled" Size="Size.Small" Class="bt-mud-primary bt-small-button" OnClick="ApplyFiltersAsync">Apply</MudButton>
            </div>
        }

        @if (_isLoading)
        {
            <MudProgressLinear Color="Color.Success" Indeterminate="true" Class="my-2" />
        }

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="my-2">@_message</MudAlert>
        }

        <div class="bt-table-scroll">
            <MudTable Items="_departments" Dense="true" Hover="true" Elevation="0" FixedHeader="true" RowsPerPage="PageSize" Height="calc(100vh - 25rem)" Style="min-width: 760px;" Breakpoint="Breakpoint.None">
                <HeaderContent>
                    <MudTh Style="width: 8rem;">Code</MudTh>
                    <MudTh Style="width: 18rem;">Name</MudTh>
                    <MudTh>Description</MudTh>
                    <MudTh Style="width: 8rem;">Status</MudTh>
                    <MudTh Style="width: 8rem;">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Code">@context.Code</MudTd>
                    <MudTd DataLabel="Name">@context.Name</MudTd>
                    <MudTd DataLabel="Description">@context.Description</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                            @(context.IsActive ? "Active" : "Inactive")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <TableRowActions OnView="@(() => OpenViewDialogAsync(context))"
                                         OnEdit="@(() => OpenFormDialogAsync(context))"
                                         OnDelete="@(() => ConfirmDeleteAsync(context))"
                                         CanView="@AuthSession.HasPermission("departments.view")"
                                         CanEdit="@AuthSession.HasPermission("departments.edit")"
                                         CanDelete="@AuthSession.HasPermission("departments.delete")" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">No department records found.</MudAlert>
                </NoRecordsContent>
                <PagerContent>
                    <div class="table-footer">
                        <span>@FooterText</span>
                        <div class="pagination-actions">
                            <MudIconButton Icon="@Icons.Material.Filled.FirstPage" Size="Size.Small" Disabled="@(_isFirstPage || _isLoading)" OnClick="GoToFirstPageAsync" />
                            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" Disabled="@(_isFirstPage || _isLoading)" OnClick="GoToPreviousPageAsync" />
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">Page @_currentPage</MudChip>
                            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Disabled="@(_isLastPage || _isLoading)" OnClick="GoToNextPageAsync" />
                        </div>
                    </div>
                </PagerContent>
            </MudTable>
        </div>
    </MudPaper>
</section>

@code {
    private readonly List<DepartmentResponse> _departments = [];
    private readonly Stack<Guid?> _cursorHistory = new();
    private Guid? _nextCursor;
    private Guid? _currentCursor;
    private int _totalRecords;
    private int _currentPage = 1;
    private bool _isFirstPage = true;
    private bool _isLastPage = true;
    private bool _isLoading = true;
    private bool _showFilters;
    private string? _searchText;
    private bool? _isActiveFilter;
    private string? _message;
    private const int PageSize = 50;

    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(_searchText) || _isActiveFilter.HasValue;

    private string _statusLabel => _isLoading ? "Loading" : $"{_departments.Count} shown";

    private string FooterText => _totalRecords == 0
        ? "Showing 0 records"
        : $"Showing {CurrentPageStart}-{CurrentPageEnd} of {_totalRecords} records";

    private int CurrentPageStart => ((_currentPage - 1) * PageSize) + 1;

    private int CurrentPageEnd => Math.Min(CurrentPageStart + _departments.Count - 1, _totalRecords);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AuthSession.InitializeAsync();
        if (!AuthSession.IsAuthenticated)
        {
            Navigation.NavigateTo("/iam/sign-in");
            return;
        }

        ResetPagination();
        await LoadDepartmentsAsync();
    }

    private Task ApplyFiltersAsync()
    {
        ResetPagination();
        return LoadDepartmentsAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _searchText = null;
        _isActiveFilter = null;
        _showFilters = false;
        ResetPagination();
        await LoadDepartmentsAsync();
    }

    private async Task GoToFirstPageAsync()
    {
        ResetPagination();
        await LoadDepartmentsAsync();
    }

    private async Task GoToPreviousPageAsync()
    {
        if (_cursorHistory.Count == 0)
        {
            return;
        }

        _currentCursor = _cursorHistory.Pop();
        _currentPage = Math.Max(1, _currentPage - 1);
        await LoadDepartmentsAsync();
    }

    private async Task GoToNextPageAsync()
    {
        if (_isLastPage || _nextCursor is null)
        {
            return;
        }

        _cursorHistory.Push(_currentCursor);
        _currentCursor = _nextCursor;
        _currentPage++;
        await LoadDepartmentsAsync();
    }

    private async Task LoadDepartmentsAsync()
    {
        _isLoading = true;
        _message = null;
        StateHasChanged();

        var request = new DepartmentSearchRequest(
            GlobalSearch: string.IsNullOrWhiteSpace(_searchText) ? null : _searchText.Trim(),
            IsActive: _isActiveFilter,
            Cursor: _currentCursor,
            PageSize: PageSize);

        var response = await DepartmentService.SearchAsync(request);
        if (!response.IsSuccess || response.Data is null)
        {
            _message = response.Message ?? "We could not load departments.";
            Snackbar.Add(_message, Severity.Error);
            _isLoading = false;
            StateHasChanged();
            return;
        }

        _departments.Clear();
        _departments.AddRange(response.Data.Items);
        _totalRecords = response.Data.TotalRecords;
        _nextCursor = response.Data.NextCursor == Guid.Empty ? null : response.Data.NextCursor;
        _isFirstPage = response.Data.IsFirstPage;
        _isLastPage = response.Data.IsLastPage;
        _isLoading = false;
        StateHasChanged();
    }

    private Task HandleSearchKeyDown(KeyboardEventArgs args)
        => args.Key == "Enter" ? ApplyFiltersAsync() : Task.CompletedTask;

    private void ToggleFilters() => _showFilters = !_showFilters;

    private void ResetPagination()
    {
        _cursorHistory.Clear();
        _currentCursor = null;
        _nextCursor = null;
        _currentPage = 1;
    }

    private async Task OpenViewDialogAsync(DepartmentResponse department)
    {
        var parameters = new DialogParameters
        {
            { nameof(DepartmentViewDialog.Department), department }
        };

        await DialogService.ShowAsync<DepartmentViewDialog>(
            department.Name,
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
    }

    private async Task OpenFormDialogAsync(DepartmentResponse? department)
    {
        var parameters = new DialogParameters
        {
            { nameof(DepartmentFormDialog.ExistingDepartment), department }
        };

        var title = department is null ? "Create Department" : $"Edit - {department.Name}";
        var dialog = await DialogService.ShowAsync<DepartmentFormDialog>(
            title,
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, BackdropClick = false });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            ResetPagination();
            await LoadDepartmentsAsync();
        }
    }

    private async Task ConfirmDeleteAsync(DepartmentResponse department)
    {
        var parameters = new DialogParameters
        {
            { nameof(ConfirmDialog.Message), $"Delete {department.Name}? This will remove it from active department lists." },
            { nameof(ConfirmDialog.ConfirmText), "Delete" }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            "Confirm Delete",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result is not { Canceled: false })
        {
            return;
        }

        var response = await DepartmentService.DeleteAsync(department.Id);
        if (!response.IsSuccess)
        {
            Snackbar.Add(response.Message ?? "Department delete failed.", Severity.Error);
            return;
        }

        Snackbar.Add($"{department.Name} deleted.", Severity.Success);
        await LoadDepartmentsAsync();
    }
}
