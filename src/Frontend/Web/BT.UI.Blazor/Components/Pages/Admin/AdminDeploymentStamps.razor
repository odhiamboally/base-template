@page "/control-panel/stamps"
@rendermode InteractiveServer
@inject IAuthSession AuthSession
@inject IDeploymentStampService StampService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Deployment Stamps | Base Template</PageTitle>

<section class="dashboard-page">
    <div class="mb-4">
        <MudButton Href="/control-panel" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Color="Color.Primary" Class="px-0">Back to Control Panel</MudButton>
    </div>

    <MudPaper Class="poc-panel" Elevation="0">
        <div class="panel-heading">
            <h2 style="color: var(--bt-moss); font-weight: 700;">Deployment Stamps</h2>
            <div class="d-flex align-center gap-3">
                @if (AuthSession.HasPermission("Permissions.ControlPlane.Manage"))
                {
                    <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Dns" OnClick="@(() => OpenFormDialogAsync(null))">Create stamp</MudButton>
                }
            </div>
        </div>

        @if (_isLoading)
        {
            <MudProgressLinear Color="Color.Success" Indeterminate="true" Class="my-2" />
        }

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="my-2">@_message</MudAlert>
        }

        <div class="bt-table-scroll">
            <MudTable @ref="_table" Items="_stamps" Dense="true" Hover="true" Elevation="0" FixedHeader="true" RowsPerPage="100" Height="calc(100vh - 25rem)" Style="min-width: 760px;" Breakpoint="Breakpoint.None">
                <HeaderContent>
                    <MudTh Style="width: 15rem;">Name</MudTh>
                    <MudTh>Resource Group</MudTh>
                    <MudTh Style="width: 10rem;">Tier</MudTh>
                    <MudTh Style="width: 8rem;">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">@context.Name</MudTd>
                    <MudTd DataLabel="Resource Group">@context.TargetResourceGroup</MudTd>
                    <MudTd DataLabel="Tier">
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">
                            @context.IsolationTier
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <TableRowActions OnEdit="@(() => OpenFormDialogAsync(context))"
                                         CanEdit="@AuthSession.HasPermission("Permissions.ControlPlane.Manage")" 
                                         CanView="true"
                                         OnView="@(() => Snackbar.Add($"Stamp: {context.Name} ({context.IsolationTier})", Severity.Info))"
                                         CanDelete="false" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">No records found.</MudAlert>
                </NoRecordsContent>
                <PagerContent>
                    <GlobalTablePager CurrentPage="(_table?.CurrentPage ?? 0) + 1"
                                      TotalRecords="_table?.GetFilteredItemsCount() ?? 0"
                                      PageSize="_table?.RowsPerPage ?? 100"
                                      OnFirstPage="@(() => _table?.NavigateTo(0))"
                                      OnPreviousPage="@(() => _table?.NavigateTo((_table?.CurrentPage ?? 1) - 1))"
                                      OnNextPage="@(() => _table?.NavigateTo((_table?.CurrentPage ?? 0) + 1))" />
                </PagerContent>
            </MudTable>
        </div>
    </MudPaper>
</section>

@code {
    private readonly List<DeploymentStampResponse> _stamps = [];
    private bool _isLoading = true;
    private string? _message;
    private MudTable<DeploymentStampResponse>? _table;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await AuthSession.InitializeAsync();
        if (!AuthSession.IsAuthenticated || !AuthSession.HasPermission("Permissions.ControlPlane.Manage"))
        {
            Navigation.NavigateTo("/iam/sign-in");
            return;
        }

        await LoadStampsAsync();
    }

    private async Task LoadStampsAsync()
    {
        _isLoading = true;
        _message = null;
        StateHasChanged();

        var response = await StampService.GetAllAsync();
        if (!response.IsSuccess || response.Data is null)
        {
            _message = response.Message ?? "We could not load stamps.";
            Snackbar.Add(_message, Severity.Error);
            _isLoading = false;
            StateHasChanged();
            return;
        }

        _stamps.Clear();
        _stamps.AddRange(response.Data);
        _isLoading = false;
        StateHasChanged();
    }

    private async Task OpenFormDialogAsync(DeploymentStampResponse? stamp)
    {
        var parameters = new DialogParameters
        {
            { nameof(StampDialog.ExistingStamp), stamp }
        };

        var title = stamp is null ? "Create Deployment Stamp" : $"Edit - {stamp.Name}";
        var dialog = await DialogService.ShowAsync<StampDialog>(
            title,
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, BackdropClick = false });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadStampsAsync();
        }
    }
}
