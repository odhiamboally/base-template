@page "/admin/employees"
@rendermode InteractiveServer
@using BT.SharedKernel.Features.HR.Employees.Dtos
@using BT.SharedKernel.Features.IAM.Users.Dtos
@using BT.UI.Rcl.Features.IAM.Users.Contracts.Interfaces
@inject IAuthSession AuthSession
@inject IDepartmentService DepartmentService
@inject IEmployeeService EmployeeService
@inject IIamAdminService IamAdminService
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Employees | Base Template</PageTitle>

<section class="dashboard-page">
    <div class="dashboard-hero compact-hero">
        <div>
            <span class="eyebrow">Administration</span>
            <h1>Employees.</h1>
            <p>Staff records, IAM linkage, employment status, and system access readiness are loaded from the HR API.</p>
        </div>
        @if (AuthSession.HasPermission("employees.create"))
        {
            <MudButton Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Filled.Badge" Class="bt-mud-primary bt-small-button" OnClick="@(() => OpenFormDialogAsync(null))">Create employee</MudButton>
        }
    </div>

    <MudPaper Class="poc-panel" Elevation="0">
        <div class="panel-heading">
            <div>
                <span class="eyebrow">Employee list</span>
                <h2>Staff directory</h2>
            </div>
            <MudChip T="string" Size="Size.Small" Color="Color.Success">@StatusLabel</MudChip>
        </div>

        <div class="list-toolbar">
            <MudTextField @bind-Value="_searchText"
                          Placeholder="Search number, name, email, phone, ID..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Margin="Margin.Dense"
                          Variant="Variant.Outlined"
                          Immediate="false"
                          DebounceInterval="400"
                          OnDebounceIntervalElapsed="ApplyFiltersAsync"
                          OnKeyDown="HandleSearchKeyDown" />
            <MudIconButton Icon="@Icons.Material.Filled.FilterList" Size="Size.Small" Color="@(_showFilters ? Color.Success : Color.Default)" OnClick="ToggleFilters" title="Advanced filters" />
            @if (HasActiveFilters)
            {
                <MudIconButton Icon="@Icons.Material.Filled.FilterAltOff" Size="Size.Small" Color="Color.Error" OnClick="ClearFiltersAsync" title="Clear filters" />
            }
        </div>

        @if (_showFilters)
        {
            <MudDivider Class="my-2" />
            <MudGrid Spacing="2" Class="mb-2">
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_departmentFilter" Label="Department" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                        @foreach (var item in _departments)
                        {
                            <MudSelectItem T="Guid?" Value="@((Guid?)item.Id)">@item.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_managerFilter" Label="Manager" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                        @foreach (var item in ManagerOptions)
                        {
                            <MudSelectItem T="Guid?" Value="@((Guid?)item.Id)">@item.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
            <div class="filter-actions">
                <MudButton Variant="Variant.Filled" Size="Size.Small" Class="bt-mud-primary bt-small-button" OnClick="ApplyFiltersAsync">Apply</MudButton>
            </div>
        }

        @if (_isLoading)
        {
            <MudProgressLinear Color="Color.Success" Indeterminate="true" Class="my-2" />
        }

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <MudAlert Severity="@_messageSeverity" Variant="Variant.Outlined" Dense="true" Class="my-2">@_message</MudAlert>
        }

        <div class="bt-table-scroll">
            <MudTable Items="_employees" Dense="true" Hover="true" Elevation="0" FixedHeader="true" RowsPerPage="PageSize" Height="calc(100vh - 25rem)" Style="min-width: 960px;" Breakpoint="Breakpoint.None">
                <HeaderContent>
                    <MudTh>Employee No.</MudTh>
                    <MudTh>Name</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Phone</MudTh>
                    <MudTh>Department</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Employee No.">@context.Number</MudTd>
                    <MudTd DataLabel="Name">@context.FullName</MudTd>
                    <MudTd DataLabel="Email">@context.Email</MudTd>
                    <MudTd DataLabel="Phone">@context.PhoneNumber</MudTd>
                    <MudTd DataLabel="Department">@DisplayDepartment(context)</MudTd>
                    <MudTd DataLabel="Actions">
                        <TableRowActions ExtraActions="@EmployeeExtraActions"
                                         OnView="@(() => OpenViewDialogAsync(context))"
                                         OnEdit="@(() => OpenFormDialogAsync(context))"
                                         OnDelete="@(() => ConfirmDeleteAsync(context))"
                                         CanView="@AuthSession.HasPermission("employees.view")"
                                         CanEdit="@AuthSession.HasPermission("employees.edit")"
                                         CanDelete="@AuthSession.HasPermission("employees.delete")"
                                         OnExtraAction="@((action) => HandleEmployeeActionAsync(context, action))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">No records found.</MudAlert>
                </NoRecordsContent>
                <PagerContent>
                    <div class="table-footer">
                        <span>@FooterText</span>
                        <div class="pagination-actions">
                            <MudIconButton Icon="@Icons.Material.Filled.FirstPage" Size="Size.Small" Disabled="@(_isFirstPage || _isLoading)" OnClick="GoToFirstPageAsync" />
                            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" Disabled="@(_isFirstPage || _isLoading)" OnClick="GoToPreviousPageAsync" />
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">Page @_currentPage</MudChip>
                            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Disabled="@(_isLastPage || _isLoading)" OnClick="GoToNextPageAsync" />
                        </div>
                    </div>
                </PagerContent>
            </MudTable>
        </div>
    </MudPaper>
</section>

@code {
    private const int PageSize = 50;
    private readonly List<EmployeeResponse> _employees = [];
    private readonly List<DepartmentResponse> _departments = [];
    private readonly Stack<Guid?> _cursorHistory = new();
    private Guid? _nextCursor;
    private Guid? _currentCursor;
    private Guid? _departmentFilter;
    private Guid? _managerFilter;
    private int _totalRecords;
    private int _currentPage = 1;
    private bool _isFirstPage = true;
    private bool _isLastPage = true;
    private bool _isLoading = true;
    private bool _showFilters;
    private string? _searchText;
    private string? _message;
    private Severity _messageSeverity = Severity.Info;

    private IReadOnlyList<ManagerFilterOption> ManagerOptions => [.. _employees
        .Where(static employee => employee.ManagerId.HasValue && !string.IsNullOrWhiteSpace(employee.ManagerName))
        .GroupBy(static employee => employee.ManagerId!.Value)
        .Select(static group => new ManagerFilterOption(group.Key, group.First().ManagerName))
        .OrderBy(static item => item.Name)];

    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(_searchText) || _departmentFilter.HasValue || _managerFilter.HasValue;

    private IReadOnlyList<string> EmployeeExtraActions
    {
        get
        {
            var actions = new List<string> { "View IAM link" };

            if (AuthSession.HasPermission("users.create"))
            {
                actions.Add("Grant system access");
            }

            if (AuthSession.HasPermission("users.deactivate"))
            {
                actions.Add("Revoke system access");
            }

            return actions;
        }
    }

    private string StatusLabel => _isLoading ? "Loading" : $"{_employees.Count} shown";

    private string FooterText => _totalRecords == 0
        ? "Showing 0 records"
        : $"Showing {CurrentPageStart}-{CurrentPageEnd} of {_totalRecords} records";

    private int CurrentPageStart => ((_currentPage - 1) * PageSize) + 1;

    private int CurrentPageEnd => Math.Min(CurrentPageStart + _employees.Count - 1, _totalRecords);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AuthSession.InitializeAsync();
        if (!AuthSession.IsAuthenticated)
        {
            Navigation.NavigateTo("/iam/sign-in");
            return;
        }

        ResetPagination();
        await LoadDepartmentsAsync();
        await LoadEmployeesAsync();
    }

    private Task ApplyFiltersAsync()
    {
        ResetPagination();
        return LoadEmployeesAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _searchText = null;
        _departmentFilter = null;
        _managerFilter = null;
        _showFilters = false;
        ResetPagination();
        await LoadEmployeesAsync();
    }

    private async Task GoToFirstPageAsync()
    {
        ResetPagination();
        await LoadEmployeesAsync();
    }

    private async Task GoToPreviousPageAsync()
    {
        if (_cursorHistory.Count == 0)
        {
            return;
        }

        _currentCursor = _cursorHistory.Pop();
        _currentPage = Math.Max(1, _currentPage - 1);
        await LoadEmployeesAsync();
    }

    private async Task GoToNextPageAsync()
    {
        if (_isLastPage || _nextCursor is null)
        {
            return;
        }

        _cursorHistory.Push(_currentCursor);
        _currentCursor = _nextCursor;
        _currentPage++;
        await LoadEmployeesAsync();
    }

    private async Task LoadEmployeesAsync()
    {
        _isLoading = true;
        _message = null;
        StateHasChanged();

        var request = new EmployeeSearchRequest(
            string.IsNullOrWhiteSpace(_searchText) ? null : _searchText.Trim(),
            _departmentFilter,
            _managerFilter,
            _currentCursor,
            PageSize);

        var response = await EmployeeService.SearchAsync(request);
        if (!response.IsSuccess || response.Data is null)
        {
            _messageSeverity = Severity.Error;
            _message = response.Message ?? "We could not load employees.";
            Snackbar.Add(_message, Severity.Error);
            _isLoading = false;
            StateHasChanged();
            return;
        }

        _employees.Clear();
        _employees.AddRange(response.Data.Items);
        _totalRecords = response.Data.TotalRecords;
        _nextCursor = response.Data.NextCursor == Guid.Empty ? null : response.Data.NextCursor;
        _isFirstPage = response.Data.IsFirstPage;
        _isLastPage = response.Data.IsLastPage;
        _isLoading = false;
        StateHasChanged();
    }

    private async Task LoadDepartmentsAsync()
    {
        var response = await DepartmentService.GetAsync();
        if (!response.IsSuccess || response.Data is null)
        {
            Snackbar.Add(response.Message ?? "We could not load departments.", Severity.Error);
            return;
        }

        _departments.Clear();
        _departments.AddRange(response.Data.OrderBy(static department => department.Name));
    }

    private string DisplayDepartment(EmployeeResponse employee)
        => !string.IsNullOrWhiteSpace(employee.DepartmentName)
            ? employee.DepartmentName
            : _departments.FirstOrDefault(department => department.Id == employee.DepartmentId)?.Name
              ?? employee.DepartmentId.ToString();

    private Task HandleSearchKeyDown(KeyboardEventArgs args)
        => args.Key == "Enter" ? ApplyFiltersAsync() : Task.CompletedTask;

    private void ToggleFilters() => _showFilters = !_showFilters;

    private void ResetPagination()
    {
        _cursorHistory.Clear();
        _currentCursor = null;
        _nextCursor = null;
        _currentPage = 1;
    }

    private async Task OpenViewDialogAsync(EmployeeResponse employee)
    {
        var parameters = new DialogParameters { { nameof(EmployeeViewDialog.Employee), employee } };
        await DialogService.ShowAsync<EmployeeViewDialog>(
            employee.FullName,
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });
    }

    private async Task OpenFormDialogAsync(EmployeeResponse? employee)
    {
        var parameters = new DialogParameters { { nameof(EmployeeFormDialog.ExistingEmployee), employee } };
        var title = employee is null ? "Create Employee" : $"Edit - {employee.FullName}";
        var dialog = await DialogService.ShowAsync<EmployeeFormDialog>(
            title,
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, BackdropClick = false });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            ResetPagination();
            await LoadEmployeesAsync();
        }
    }

    private async Task ConfirmDeleteAsync(EmployeeResponse employee)
    {
        var parameters = new DialogParameters
        {
            { nameof(ConfirmDialog.Message), $"Delete {employee.FullName}? This removes the employee record." },
            { nameof(ConfirmDialog.ConfirmText), "Delete" }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            "Confirm Delete",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result is not { Canceled: false })
        {
            return;
        }

        var response = await EmployeeService.DeleteAsync(employee.Id);
        if (!response.IsSuccess)
        {
            Snackbar.Add(response.Message ?? "Employee delete failed.", Severity.Error);
            return;
        }

        Snackbar.Add($"{employee.FullName} deleted.", Severity.Success);
        await LoadEmployeesAsync();
    }

    private async Task HandleEmployeeActionAsync(EmployeeResponse employee, string action)
    {
        if (action.Equals("Grant system access", StringComparison.OrdinalIgnoreCase))
        {
            await OpenGrantAccessDialogAsync(employee);
            return;
        }

        if (action.Equals("Revoke system access", StringComparison.OrdinalIgnoreCase))
        {
            await ConfirmRevokeAccessAsync(employee);
            return;
        }

        await ShowIamLinkAsync(employee);
    }

    private async Task OpenGrantAccessDialogAsync(EmployeeResponse employee)
    {
        var parameters = new DialogParameters
        {
            { nameof(EmployeeGrantAccessDialog.Employee), employee }
        };

        var dialog = await DialogService.ShowAsync<EmployeeGrantAccessDialog>(
            $"Grant access - {employee.FullName}",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true, BackdropClick = false });

        var result = await dialog.Result;
        if (result is not { Canceled: false } || result.Data is not string[] roles)
        {
            return;
        }

        var response = await IamAdminService.GrantEmployeeSystemAccessAsync(employee.Id, new GrantEmployeeSystemAccessRequest(roles));
        if (!response.IsSuccess)
        {
            Snackbar.Add(response.Message ?? "System access grant failed.", Severity.Warning);
            return;
        }

        Snackbar.Add(response.Message ?? "System access granted.", Severity.Success);
    }

    private async Task ConfirmRevokeAccessAsync(EmployeeResponse employee)
    {
        var parameters = new DialogParameters
        {
            { nameof(ConfirmDialog.Message), $"Revoke system access for {employee.FullName}? The linked IAM account will be deactivated and active sessions will be terminated." },
            { nameof(ConfirmDialog.ConfirmText), "Revoke" }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            "Revoke System Access",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result is not { Canceled: false })
        {
            return;
        }

        var response = await IamAdminService.RevokeEmployeeSystemAccessAsync(
            employee.Id,
            new DeactivateUserRequest("Revoked from employee administration."));

        if (!response.IsSuccess)
        {
            Snackbar.Add(response.Message ?? "System access revoke failed.", Severity.Warning);
            return;
        }

        Snackbar.Add(response.Message ?? "System access revoked.", Severity.Success);
    }

    private async Task ShowIamLinkAsync(EmployeeResponse employee)
    {
        var response = await IamAdminService.SearchUsersAsync(new AdminUserSearchRequest(EmployeeId: employee.Id, PageSize: 1));
        if (!response.IsSuccess || response.Data is null)
        {
            Snackbar.Add(response.Message ?? "We could not load the IAM link.", Severity.Error);
            return;
        }

        var user = response.Data.Items.FirstOrDefault();
        if (user is null)
        {
            Snackbar.Add($"{employee.FullName} is not linked to an IAM user account.", Severity.Info);
            return;
        }

        var status = user.IsActive ? "active" : "inactive";
        Snackbar.Add($"{employee.FullName} is linked to {user.Email} ({status}).", Severity.Info);
    }

    private sealed record ManagerFilterOption(Guid Id, string Name);
}
