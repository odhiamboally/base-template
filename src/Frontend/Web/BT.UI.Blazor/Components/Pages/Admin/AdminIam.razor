@page "/admin/iam"

@rendermode InteractiveServer
@inject IAuthSession AuthSession

<PageTitle>Identity & Access | Base Template</PageTitle>

<RequireAuthenticated>
    <section class="dashboard-page">
        <div class="dashboard-hero compact-hero">
            <div>
                <span class="eyebrow">Administration</span>
                <h1>Identity & Access.</h1>
                <p>Manage roles, permissions, users, and trusted devices across the platform.</p>
            </div>
            @if (_activeTab == 0 && AuthSession.HasPermission("roles.create"))
            {
                <MudButton Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Filled.AddModerator" Class="bt-mud-primary bt-small-button" OnClick="OpenRoleCreateDialogAsync">Create role</MudButton>
            }
            else if (_activeTab == 1 && AuthSession.HasPermission("roles.manage_permissions"))
            {
                <MudButton Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Filled.LockPerson" Class="bt-mud-primary bt-small-button" OnClick="OpenPermissionCreateDialogAsync">Create permission</MudButton>
            }
            else if (_activeTab == 2 && AuthSession.HasPermission("users.create"))
            {
                <MudButton Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Filled.PersonAdd" Class="bt-mud-primary bt-small-button" OnClick="OpenUserCreateDialogAsync">Create user</MudButton>
            }
        </div>

        <MudPaper Class="poc-panel" Elevation="0">
            <MudTabs ActivePanelIndex="_activeTab" ActivePanelIndexChanged="OnTabChanged" Rounded="true" Elevation="0" Class="bt-catalog-tabs">
                <MudTabPanel Text="Roles" />
                <MudTabPanel Text="Permissions" />
                <MudTabPanel Text="Users" />
                <MudTabPanel Text="User Devices" />
            </MudTabs>

            @if (_activeTab == 0)
            {
                <AdminRoles @ref="_rolesTab" />
            }
            else if (_activeTab == 1)
            {
                <AdminPermissions @ref="_permissionsTab" />
            }
            else if (_activeTab == 2)
            {
                <AdminUsers @ref="_usersTab" />
            }
            else if (_activeTab == 3)
            {
                <AdminUserDevices />
            }
        </MudPaper>
    </section>
</RequireAuthenticated>

@code {
    private int _activeTab;
    private AdminRoles? _rolesTab;
    private AdminPermissions? _permissionsTab;
    private AdminUsers? _usersTab;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthSession.InitializeAsync();
            StateHasChanged();
        }
    }

    private void OnTabChanged(int index)
    {
        _activeTab = index;
    }

    private Task OpenRoleCreateDialogAsync() =>
        _rolesTab?.OpenCreateDialogAsync() ?? Task.CompletedTask;

    private Task OpenPermissionCreateDialogAsync() =>
        _permissionsTab?.OpenCreateDialogAsync() ?? Task.CompletedTask;

    private Task OpenUserCreateDialogAsync() =>
        _usersTab?.OpenCreateDialogAsync() ?? Task.CompletedTask;
}
