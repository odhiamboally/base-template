@page "/features"

@rendermode InteractiveServer
@inject IAuthSession AuthSession
@inject IIamAdminService IamAdminService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Features | Base Template</PageTitle>

<RequireAuthenticated>
    <section class="dashboard-page">
        @if (!_isReady)
        {
            <MudPaper Class="status-card" Elevation="0">Loading features...</MudPaper>
        }
        else
        {
            <div class="dashboard-hero compact-hero">
                <div>
                    <span class="eyebrow">Platform</span>
                    <h1>Features.</h1>
                    <p>Explore reusable platform capability showcases.</p>
                </div>
            </div>

            <div class="admin-module-grid">
                @foreach (var module in _modules)
                {
                    <MudPaper Class="admin-tile" Elevation="0">
                        <MudIcon Icon="@MenuIconMapper.Resolve(module.Icon)" Class="tile-icon" />
                        <div>
                            <strong>@module.Title</strong>
                            <span>@module.Description</span>
                        </div>
                        <MudButton Href="@module.Url" Variant="Variant.Text" Size="Size.Small" Class="bt-small-button" EndIcon="@Icons.Material.Filled.ArrowForward">
                            Open
                        </MudButton>
                    </MudPaper>
                }
            </div>
        }
    </section>
</RequireAuthenticated>

@code {
    private readonly List<MenuResponse> _modules = [];
    private bool _isReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AuthSession.InitializeAsync();
        if (AuthSession.IsAuthenticated)
        {
            await LoadModulesAsync();
            StateHasChanged();
        }
    }

    private async Task LoadModulesAsync()
    {
        var response = await IamAdminService.GetNavigationMenusAsync("Features");
        if (!response.IsSuccess || response.Data is null)
        {
            Snackbar.Add(response.Message ?? "We could not load feature menus.", Severity.Error);
            _isReady = true;
            return;
        }

        _modules.Clear();
        var allMenus = Flatten(response.Data);
        _modules.AddRange(allMenus);
        _isReady = true;
    }

    private static IEnumerable<MenuResponse> Flatten(IEnumerable<MenuResponse> menus)
    {
        foreach (var menu in menus)
        {
            yield return menu;
            foreach (var child in Flatten(menu.Children))
            {
                yield return child;
            }
        }
    }
}
