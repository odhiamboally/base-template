{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Seq",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.CorrelationId"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/dev-log-.json",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentUserName"
    ]
  },

  "Observability": {
    "Enabled": false,
    "ServiceName": "LlanCore.BaseTemplate.API",
    "ServiceNamespace": "LlanCore",
    "AzureMonitor": {
      "ConnectionString": ""
    }
  },

  "Resilience": {
    "Enabled": true
  },

  "Messaging": {
    "Enabled": true,
    "Transport": "RabbitMq",
    "RabbitMq": {
      "Host": "localhost",
      "VirtualHost": "/",
      "Username": "admin",
      "Password": "SET_VIA_USER_SECRETS"
    },
    "AzureServiceBus": {
      "ConnectionString": ""
    }
  },

  "BackgroundJobs": {
    "Enabled": false
  },

  "CacheSettings": {
    "Provider": "Redis",
    "Redis": {
      "ConnectionString": "SET_VIA_USER_SECRETS"
    },
    "Azure": {
      "ConnectionString": "",
      "UseEntraId": false,
      "PrincipalId": ""
    }
  },

  "EmailSettings": {
    "Host": "localhost",
    "Port": 1025,
    "EnableSsl": false,
    "UseAuthentication": false,
    "Username": "",
    "Password": "",
    "FromAddress": "noreply@basetemplate.local",
    "DisplayName": "LlanCore BaseTemplate",
    "ClientBaseUrl": "https://localhost:7049",
    "TemplatePath": "EmailTemplates"
  },

  "DevelopmentSeed": {
    "Enabled": true,
    "AdminUserName": "aamodhiambo@gmail.com",
    "AdminEmail": "aamodhiambo@gmail.com",
    "AdminPassword": "Admin@12345",
    "TenantId": "0194f700-0000-7000-8000-000000000001"
  },

  "Tenant": {
    "DefaultTenantId": "0194f700-0000-7000-8000-000000000001",
    "HeaderName": "X-Tenant-Id"
  },

  "IamProvisioning": {
    "TemporaryPassword": "Admin@12345",
    "SignInUrl": "https://localhost:7049/iam/sign-in"
  },

  "AuthProvider": {
    "Enabled": true,
    "Provider": "AspNetCoreIdentity"
  },

  "MediatR": {
    "LicenseKey": "REPLACE_VIA_USER_SECRETS_OR_KEY_VAULT"
  },
  "DataProtection": {
    "KeysPath": "",
    "UseExternalKeyStore": false,
    "KeyEncryptionMode": "Auto",
    "CertificateThumbprint": "",
    "BlobKeyUri": "",
    "KeyVaultKeyIdentifier": ""
  },

  "ProfileImageStorage": {
    "Provider": "Local",
    "MaxBytes": 2097152,
    "LocalRootPath": "uploads/profile-images",
    "PublicBasePath": "/uploads/profile-images",
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp"
    ],
    "AzureBlob": {
      "ContainerUri": "",
      "ConnectionString": "",
      "ContainerName": "",
      "BlobPrefix": "profile-images"
    },
    "Azurite": {
      "ContainerUri": "",
      "ConnectionString": "",
      "ContainerName": "",
      "BlobPrefix": "profile-images"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "SET_VIA_USER_SECRETS"
  },

  "AllowedHosts": "*"
}
