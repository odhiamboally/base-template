{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "MediatR": {
    "LicenseKey": "REPLACE_VIA_USER_SECRETS_OR_KEY_VAULT"
  },
  "DataProtection": {
    "ApplicationName": "BaseTemplate",
    "KeysPath": "",
    "UseExternalKeyStore": true,
    "KeyEncryptionMode": "Auto",
    "CertificateThumbprint": ""
  },
  "AllowedOrigins": [
    "https://localhost:7049",
    "http://localhost:5106"
  ],
  "DatabaseSettings": {
    "Provider": "SqlServer"
  },

  "ConnectionStrings": {
    "DefaultConnection": "REPLACE_VIA_USER_SECRETS_OR_ENV_VAR"
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Seq",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.CorrelationId"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.json",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "retainedFileCountLimit": 31
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentUserName"
    ],
    "Properties": {
      "Application": "BaseTemplate"
    }
  },

  "JwtSettings": {
    "SecretKey": "REPLACE_VIA_USER_SECRETS_OR_ENV_VAR",
    "Issuer": "BaseTemplate",
    "Audience": "BaseTemplateUsers",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryHours": 8,
    "ClockSkew": 1

  },

  "EmailSettings": {
    "Provider": "NoOp",
    "FromAddress": "noreply@basetemplate.local",
    "DisplayName": "BaseTemplate",
    "ClientBaseUrl": "https://localhost:7049",
    "TemplatePath": "EmailTemplates",
    "AllowNoOpInProduction": false,
    "LocalMailpit": {
      "Host": "localhost",
      "Port": 1025
    },
    "SendGrid": {
      "Endpoint": "https://api.sendgrid.com/v3/mail/send",
      "ApiKey": ""
    }
  },
  "PasswordRecovery": {
    "Mode": "EmailOtp",
    "ResetPath": "/iam/reset-password"
  },

  "SmsSettings": {
    "EnableProviderFallback": true,
    "Twilio": {
      "ProviderName": "Twilio",
      "AccountSid": "",
      "AuthToken": "",
      "FromNumber": ""
    }
  },

  "ApiSettings": {
    "BaseUrl": "https://localhost:7129/"
  },

  "CacheSettings": {
    "Provider": "Auto",
    "Redis": {
      "ConnectionString": ""
    },
    "Azure": {
      "ConnectionString": "",
      "UseEntraId": false,
      "PrincipalId": ""
    }
  },

  "Resilience": {
    "Enabled": true
  },

  "FeatureFlags": {
    "Provider": "Configuration",
    "FailClosed": true,
    "Flags": {
    }
  },

  "Reporting": {
    "QuestPdf": {
      "Enabled": true,
      "License": "Community"
    }
  },

  "Payments": {
    "Provider": "NoOp",
    "AllowNoOpInProduction": false,
    "Stripe": {
      "SecretKey": "",
      "CheckoutSessionsEndpoint": "https://api.stripe.com/v1/checkout/sessions",
      "SuccessUrl": "",
      "CancelUrl": ""
    },
    "Mpesa": {
      "ConsumerKey": "",
      "ConsumerSecret": "",
      "ShortCode": "",
      "PassKey": "",
      "AccountReference": "BaseTemplate",
      "AuthEndpoint": "/oauth/v1/generate?grant_type=client_credentials",
      "StkPushEndpoint": "/mpesa/stkpush/v1/processrequest",
      "StkQueryEndpoint": "/mpesa/stkpushquery/v1/query",
      "C2BRegisterUrlEndpoint": "/mpesa/c2b/v1/registerurl",
      "C2BSimulateEndpoint": "/mpesa/c2b/v1/simulate",
      "CallbackUrlBase": ""
    }
  },

  "ResponseCompression": {
    "Enabled": true,
    "EnableForHttps": true
  },

  "RateLimiting": {
    "Enabled": true,
    "LoginPolicy": {
      "PermitLimit": 10,
      "WindowSeconds": 120,
      "QueueLimit": 3
    },
    "AuthPolicy": {
      "PermitLimit": 5,
      "WindowSeconds": 60,
      "QueueLimit": 2
    },
    "ApiPolicy": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "QueueLimit": 10
    },
    "PasswordResetPolicy": {
      "PermitLimit": 3,
      "WindowSeconds": 900,
      "QueueLimit": 0
    },
    "TwoFactorPolicy": {
      "PermitLimit": 10,
      "WindowSeconds": 300,
      "QueueLimit": 3
    },
    "FileUploadPolicy": {
      "PermitLimit": 20,
      "WindowSeconds": 3600,
      "QueueLimit": 5
    },
    "RefreshTokenPolicy": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 2
    }
  },

  "HealthChecks": {
    "SqlServer": true,
    "Redis": true,
    "ProfileImageStorage": true,
    "KeyVault": false,
    "KeyVaultProbeSecretName": ""
  },

  "Messaging": {
    "Enabled": true,
    "Transport": "RabbitMq",
    "RabbitMq": {
      "Host": "localhost",
      "VirtualHost": "/",
      "Username": "admin",
      "Password": "REPLACE_VIA_USER_SECRETS_OR_ENV_VAR"
    },
    "AzureServiceBus": {
      "ConnectionString": ""
    }
  },

  "BackgroundJobs": {
    "Enabled": true
  },

  "DevelopmentSeed": {
    "Enabled": false,
    "AdminUserName": "aamodhiambo@gmail.com",
    "AdminEmail": "aamodhiambo@gmail.com",
    "AdminPassword": "Admin@12345",
    "TenantId": "0194f700-0000-7000-8000-000000000001"
  },

  "Tenant": {
    "DefaultTenantId": "0194f700-0000-7000-8000-000000000001",
    "HeaderName": "X-Tenant-Id"
  },

  "IamProvisioning": {
    "TemporaryPassword": "REPLACE_VIA_USER_SECRETS_OR_KEY_VAULT",
    "SignInUrl": "https://localhost:7049/iam/sign-in"
  },

  "AuthProvider": {
    "Enabled": true,
    "Provider": "AspNetCoreIdentity"
  },

  "EntraId": {
    "Enabled": false,
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "CallbackPath": "/signin-oidc",
    "AutoLinkByVerifiedEmail": true
  },

  "Observability": {
    "Enabled": true,
    "ServiceName": "BaseTemplate.API",
    "ServiceNamespace": "BaseTemplate",
    "AzureMonitor": {
      "ConnectionString": ""
    },
    "Otlp": {
      "Endpoint": "",
      "Headers": ""
    }
  },

  "ProfileImageStorage": {
    "Provider": "Local",
    "MaxBytes": 2097152,
    "LocalRootPath": "uploads/profile-images",
    "PublicBasePath": "/uploads/profile-images",
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp"
    ],
    "AzureBlob": {
      "ContainerUri": "",
      "ConnectionString": "",
      "ContainerName": "",
      "BlobPrefix": "profile-images"
    },
    "Azurite": {
      "ContainerUri": "",
      "ConnectionString": "",
      "ContainerName": "",
      "BlobPrefix": "profile-images"
    },
    "S3": {
      "ServiceUrl": "",
      "AccessKey": "",
      "SecretKey": "",
      "BucketName": "",
      "PublicBaseUrl": ""
    }
  },

  "SecuritySettings": {
    "Mfa": {
      "Enabled": true,
      "EnforceEnrollment": true,
      "RequiredRoles": [
        "System Administrator"
      ]
    },
    "SessionSettings": {
      "MaxConcurrentSessions": 1,
      "SessionTimeoutMinutes": 30,
      "SlidingExpiration": true,
      "CleanupIntervalMinutes": 30,
      "EnableConcurrentSessionNotification": true,
      "UseLockScreen": true
    }
  }
}
