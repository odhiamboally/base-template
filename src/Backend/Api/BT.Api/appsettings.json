{
  "AllowedHosts": "*",

  "AllowedOrigins": [
    "https://localhost:7016",
    "http://localhost:5193"
  ],

  "ConnectionStrings": {
    "DefaultConnection": "REPLACE_VIA_USER_SECRETS_OR_ENV_VAR"
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Seq",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.CorrelationId"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.json",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "retainedFileCountLimit": 31
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentUserName"
    ],
    "Properties": {
      "Application": "LlanCore.BaseTemplate"
    }
  },

  "JwtSettings": {
    "Issuer": "LlanCore",
    "Audience": "LlanCoreUsers",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryHours": 8,
    "ClockSkew": 1

  },

  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "FromAddress": "noreply@llancore.com",
    "DisplayName": "LlanCore",
    "ClientBaseUrl": "https://localhost:7016",
    "TemplatePath": "EmailTemplates"
  },

  "FileSettings": {
    "MaxFileSize": 10485760,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".pdf", ".doc", ".docx" ]
  },

  "CacheSettings": {
    "Azure": {
      "ConnectionString": "your-azure-redis-connection-string"
    }
  },

  "Resilience": {
    "Enabled": true
  },

  "Messaging": {
    "Transport": "RabbitMq",
    "RabbitMq": {
      "Host": "localhost",
      "VirtualHost": "/",
      "Username": "admin",
      "Password": "guest"
    },
    "AzureServiceBus": {
      "ConnectionString": ""
    }
  },

  "AuthProvider": {
    "Enabled": true,
    "Provider": "AspNetCoreIdentity"
  },

  "Observability": {
    "Enabled": true,
    "ServiceName": "LlanCore.BaseTemplate.API",
    "ServiceNamespace": "LlanCore",
    "AzureMonitor": {
      "ConnectionString": ""
    }
  },

  "DataProtection": {
    "KeysPath": ""
  },

  "SecuritySettings": {
    "SessionSettings": {
      "MaxConcurrentSessions": 1,
      "SessionTimeoutMinutes": 30,
      "SlidingExpiration": true,
      "CleanupIntervalMinutes": 30,
      "EnableConcurrentSessionNotification": true,
      "UseLockScreen": true
    }
  }
}